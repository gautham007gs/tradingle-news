Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS on production host
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^(www\.)?tradingle\.com$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # robots.txt, sitemaps and RSS are generated by the Next.js route handlers
  # (app/robots.ts, app/sitemap.ts, app/news-sitemap.xml, app/feed.xml).
  # Do NOT rewrite them to PHP — they are served by Node below.

  # Never proxy the API tree — served by PHP directly
  RewriteRule ^api/ - [L]

  # User uploads — serve as static files
  RewriteRule ^uploads/ - [L]

  # Static files that physically exist in the docroot (favicon, og-image,
  # critical-shell.css, fonts, images, etc.) — bypass the Node proxy.
  # A bare extension match is NOT used here: /sitemap.xml, /news-sitemap.xml,
  # /rss.xml and /robots.txt are generated by Next.js route handlers and must
  # reach Node, so only real files short-circuit.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Everything else → Next.js standalone server (deploy-hostinger.md §7).
  # Directories and unknown paths are proxied to Node so the SSR app handles them.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>

<IfModule mod_http2.c>
  Protocols h2 h2c http/1.1
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Powered-By "Tradingle"

  # Long-lived cache for fingerprinted build assets
  <FilesMatch "\.(?:js|mjs|css|woff2?|ttf|eot|webp|png|jpg|jpeg|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML — revalidate every visit, allow 304
  <FilesMatch "\.(?:html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
  AddOutputFilter DEFLATE js css
</IfModule>
